# .env.example — echte Werte in .env.local (gitignored)
POSTGRES_URL=postgres://...
# POSTGRES_URL_TEST ist optional: lokal ohne Wert booten Tests automatisch eine
# embedded-postgres-Instanz (siehe tests/setup/global-setup.ts). Nur für CI oder
# ein echtes Postgres/Neon als Override setzen — strikt getrennt von POSTGRES_URL.
POSTGRES_URL_TEST=postgres://...
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Tooling-Mission (Werte kommen mit docs/tooling/einkaufsliste.md) ──
# Fehler-Monitoring (Sentry, Org in EU-Region Frankfurt anlegen!)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Dead-Man-Switch des Workers (healthchecks.io Ping-URL)
HEALTHCHECKS_PING_URL=
# KI (Anthropic Console; Spend-Limit setzen)
ANTHROPIC_API_KEY=
# Karten-Tiles (Stadia Maps; Dev läuft ohne Key über OpenFreeMap)
NEXT_PUBLIC_STADIA_MAPS_API_KEY=
# Geocoding (Geoapify, Free-Tier kommerziell erlaubt; Attribution einbauen)
GEOAPIFY_API_KEY=
# Backup (worker/backup/backup.sh): separater Bucket + age-Empfängerschlüssel
S3_BUCKET_BACKUP=
AGE_PUBLIC_KEY=
