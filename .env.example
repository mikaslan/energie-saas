# .env.example — Vorlage; echte Werte liegen getrennt in den Secret-Stores der
# jeweiligen Dienste. System-/Migration-/Backupwerte gehören NICHT in .env.local
# des Next.js-Prozesses.
# Standard ist fail-closed: jede Verbindung muss ihren exakten SQL-erzeugten
# Principal tragen. Nur die Testsuite setzt test-legacy-single gegen eine DB,
# deren Name "test" enthält.
DB_ROLE_MODE=strict
# Optionaler PG18-Providervertrag, immer als Paar. Leer bedeutet den exakten
# lokalen Superuser-Fixture-Vertrag (Grantor postgres, keine Auto-Kanten).
# Für eine Legacy-Upgrade-DB zusätzlich die bewusst quarantänierte Altrolle
# setzen; Fresh-Datenbanken lassen DB_ROLE_RETAINED_LEGACY_ROLE leer.
DB_ROLE_PROVISIONING_ADMIN=
DB_ROLE_BOOTSTRAP_GRANTOR=
DB_ROLE_RETAINED_LEGACY_ROLE=
POSTGRES_URL=postgres://app_runtime:...@<direkt-ohne-pooler>:5432/...?sslmode=verify-full
POSTGRES_URL_AUTH=postgres://app_auth:...@<direkt-ohne-pooler>:5432/...?sslmode=verify-full
# Nur im Next.js-Secret-Store, nie als NEXT_PUBLIC_* oder im Rechner-Browser.
# JSON-Array aus keyId, workspaceId, scope=rechner-intake.write und
# secretBase64 (32–64 Zufallsbytes). Leer bleibt der Endpoint fail-closed.
RECHNER_INTAKE_KEYS_JSON=
# Nicht geheim: exakte serverseitige Neon-Identität. Bei *.neon.tech sind
# beide Werte Pflicht und werden auf jeder neuen Dienstverbindung gegen
# neon.tenant_id/neon.timeline_id geprüft. Exakt 32 kleingeschriebene
# Hexzeichen. Nach Branch-Restore/Endpoint-Transfer bewusst aktualisieren und
# alle Dienstprozesse neu starten.
POSTGRES_EXPECTED_NEON_TENANT_ID=
POSTGRES_EXPECTED_NEON_TIMELINE_ID=
# Direkter, ungepoolter Endpunkt. In allen Dienst-/Migrations-URLs sind als
# Queryparameter nur sslmode=verify-full erlaubt und für nicht lokale Ziele
# Pflicht; Principal-/Host-Overrides sind rot.
POSTGRES_URL_MIGRATE=postgres://app_migrator:...@...:5432/...?sslmode=verify-full
POSTGRES_URL_WORKER=postgres://app_worker:...@<direkt-ohne-pooler>:5432/...?sslmode=verify-full
# Ausschließlich isolierter Bootstrap-/Recovery-Prozess; NIE Web-App/Vercel.
POSTGRES_URL_SYSTEM=postgres://app_system:...@...:5432/...?sslmode=verify-full
# Ausschließlich einmaliges, beaufsichtigtes Legacy-Cutover. Beide URLs tragen
# denselben direkten Host/Port/SUPERUSER-Principal, aber verschiedene Datenbanken.
# Control bleibt auch erreichbar, wenn das Target ALLOW_CONNECTIONS=false hat.
POSTGRES_URL_CUTOVER_ADMIN=postgres://admin:...@...:5432/<target>?sslmode=verify-full
POSTGRES_URL_CUTOVER_CONTROL=postgres://admin:...@...:5432/<control>?sslmode=verify-full
CUTOVER_EXPECTED_DATABASE=
CUTOVER_EXPECTED_DATABASE_CONNECTION_LIMIT=-1
# Exakte kanonische JSON-Keys, die das Script bei Abweichung ausgibt.
CUTOVER_EXPECTED_TARGET=
CUTOVER_EXPECTED_CONTROL_TARGET=
CUTOVER_LEGACY_ROLE=
CUTOVER_LEGACY_ROLE_SCOPE_CONFIRMED=
CUTOVER_EXPECTED_IDENTITY_BOOTSTRAP_GRANTOR=
CUTOVER_SAMPLE_WORKSPACE_ID=
CUTOVER_SAMPLE_USER_ID=
CUTOVER_PGBOSS_JOB_ID=
CUTOVER_CONFIRM=
# Normalerweise leer. Nur für die im Runbook beschriebene admin-only Recovery
# eines bereits fail-closed eingefrorenen Targets exakt setzen.
CUTOVER_RECOVERY_CONFIRM=
# Ausschließlich Host-Cron/Backup-Umgebung; getrennte libpq-Werte vermeiden
# Passwort/URL in Prozessargumenten und stehen nie in Runtime/Worker-Containern.
# Exakter Zieltyp: "neon" verlangt die beiden dedizierten serverseitigen IDs und
# einen leeren System-Identifier; "postgres" verlangt umgekehrt die clusterweite
# System-ID und beide Neon-Werte leer. Der Backup-Lauf attestiert Ziel/PG18 vor
# und nach dem Dump mit psql -X unter derselben libpq-Konfiguration.
POSTGRES_BACKUP_PROVIDER=neon
POSTGRES_BACKUP_HOST=
POSTGRES_BACKUP_PORT=5432
POSTGRES_BACKUP_DATABASE=
POSTGRES_BACKUP_USER=app_backup
POSTGRES_BACKUP_EXPECTED_NEON_TENANT_ID=
POSTGRES_BACKUP_EXPECTED_NEON_TIMELINE_ID=
# Nur fuer POSTGRES_BACKUP_PROVIDER=postgres: exakte clusterweite ID aus
# (pg_catalog.pg_control_system()).system_identifier; bei neon leer lassen.
POSTGRES_BACKUP_EXPECTED_SYSTEM_IDENTIFIER=
# Vorprovisionierte libpq-Passfile (0600/0400), nur auf dem Backup-Host.
POSTGRES_BACKUP_PASSFILE=/run/secrets/energie-saas-backup.pgpass
POSTGRES_BACKUP_SSLMODE=verify-full
POSTGRES_BACKUP_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
# POSTGRES_URL_TEST ist optional: lokal ohne Wert booten Tests automatisch eine
# embedded-postgres-Instanz (siehe tests/setup/global-setup.ts). Nur für CI oder
# ein echtes Postgres/Neon als Override setzen — strikt getrennt von POSTGRES_URL.
POSTGRES_URL_TEST=postgres://...?sslmode=verify-full
# Exakt an Host/Port/DB gebundene Freigabe für externe, destruktiv beschriebene Test-DBs.
POSTGRES_TEST_TARGET_CONFIRM=host:5432/test_db:ALLOW-DESTRUCTIVE-TESTS
# Nur für strukturelle Testaussagen; niemals als App-/Migrations-URL verwenden.
POSTGRES_URL_TEST_SUPERUSER=postgres://...?sslmode=verify-full
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Tooling-Mission (Werte kommen mit docs/tooling/einkaufsliste.md) ──
# Fehler-Monitoring (Sentry, Org in EU-Region Frankfurt anlegen!)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Dead-Man-Switch des Workers (healthchecks.io Ping-URL)
HEALTHCHECKS_PING_URL=
# KI (Anthropic Console; Spend-Limit setzen)
ANTHROPIC_API_KEY=
# Karten-Tiles (Stadia Maps; Dev läuft ohne Key über OpenFreeMap)
NEXT_PUBLIC_STADIA_MAPS_API_KEY=
# Geocoding (Geoapify, Free-Tier kommerziell erlaubt; Attribution einbauen)
GEOAPIFY_API_KEY=
# Hetzner Cloud API-Token (Projekt-Token, Lese+Schreib) — nur lokal genutzt von
# scripts/hetzner-provision.py, gehoert NICHT in Vercel-/Runtime-Envs
HCLOUD_TOKEN=
# Backup (worker/backup/backup.sh): eigener, nur auf dem Backup-Host liegender
# Bucket-Key; kein Fallback auf Archiv-/App-Credentials. Erfolgreiche Readbacks
# belegen keine IAM-Minimalitaet oder fehlende Governance-Bypass-Rechte; diese
# Negativfaehigkeiten brauchen einen separaten realen Provider-Test.
# Der vertrauenswuerdige systemd-Launcher setzt einen festen PATH/PS4, entfernt
# BASH_ENV/ENV/SHELLOPTS/BASHOPTS und startet niemals mit -x. Diese Startgrenze
# kann das danach laufende Bash-Script nicht rueckwirkend absichern.
S3_BACKUP_ENDPOINT=
S3_BACKUP_REGION=nbg1
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
S3_BACKUP_EXPECTED_OBJECT_LOCK_MODE=GOVERNANCE
S3_BACKUP_EXPECTED_RETENTION_DAYS=30
# "required" attestiert genau eine aktive Regel samt Prefix sowie Ablauf der
# aktuellen und nichtaktuellen Versionen. "provider-unsupported" verlangt eine
# externe Evidence-ID, ist aber weiterhin kein Pilot-Gate-Ersatz.
S3_BACKUP_LIFECYCLE_READBACK=required
S3_BACKUP_EXPECTED_LIFECYCLE_RULE_ID=backup-retention
S3_BACKUP_EXPECTED_LIFECYCLE_PREFIX=pg/
S3_BACKUP_EXPECTED_LIFECYCLE_CURRENT_DAYS=30
S3_BACKUP_EXPECTED_LIFECYCLE_NONCURRENT_DAYS=30
S3_BACKUP_LIFECYCLE_UNSUPPORTED_EVIDENCE_ID=
AGE_PUBLIC_KEY=
# Hostlokaler atomarer mkdir-Lock. Ein nach SIGKILL verbliebener Lock wird
# bewusst nicht automatisch gestohlen, sondern verlangt Operatorpruefung.
BACKUP_LOCK_DIR=/var/lock/energie-saas-backup.lock
BACKUP_TIMEOUT_SECONDS=3600
BACKUP_KILL_AFTER_SECONDS=15
# Eigener healthchecks.io-Check nur fuer den Backup-Cron, nicht Worker-Heartbeat.
BACKUP_DEAD_MAN_URL=
