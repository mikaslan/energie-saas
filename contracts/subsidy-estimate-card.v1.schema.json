{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wmee.internal/subsidy-estimate-card.v1.schema.json",
  "title": "WMEE subsidy estimate card v1",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "subsidy-estimate-card.v1"
    },
    "ruleVersion": {
      "type": "string",
      "const": "f56-458.v1"
    },
    "basePct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "bonusPct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "capPct": {
      "type": "number",
      "enum": [70, 80]
    },
    "dwellingUnits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "estimateEuroCents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "asOfDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "contractVersion",
    "ruleVersion",
    "basePct",
    "bonusPct",
    "capPct",
    "dwellingUnits",
    "estimateEuroCents",
    "disclaimer",
    "asOfDate"
  ],
  "additionalProperties": false
}
