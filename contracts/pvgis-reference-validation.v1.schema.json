{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wmee.internal/pvgis-reference-validation.v1.schema.json",
  "title": "WMEE PVGIS reference validation v1",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "pvgis-reference-validation.v1"
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "tiltedCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tiltedCase"
      }
    },
    "queries": {
      "$ref": "#/$defs/queries"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "toleranceVersion": {
      "type": "string",
      "const": "muneer-validation-tolerances.v1"
    },
    "gates": {
      "$ref": "#/$defs/gates"
    },
    "report": {
      "$ref": "#/$defs/report"
    }
  },
  "required": [
    "contractVersion",
    "sites",
    "tiltedCases",
    "queries",
    "fixtures",
    "toleranceVersion",
    "gates",
    "report"
  ],
  "additionalProperties": false,
  "$defs": {
    "site": {
      "type": "object",
      "properties": {
        "siteId": {
          "type": "string",
          "minLength": 1
        },
        "providerLatitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "PVGIS-Anfragekoordinate, auf 3 Nachkommastellen gerundet."
        },
        "providerLongitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "PVGIS-Anfragekoordinate, auf 3 Nachkommastellen gerundet."
        },
        "coordinateRounding": {
          "type": "string",
          "const": "pvgis-coordinate-rounding-3dp.v1"
        },
        "elevationM": {
          "type": "number",
          "minimum": -500,
          "maximum": 9000
        }
      },
      "required": [
        "siteId",
        "providerLatitude",
        "providerLongitude",
        "coordinateRounding",
        "elevationM"
      ],
      "additionalProperties": false
    },
    "tiltedCase": {
      "type": "object",
      "properties": {
        "tiltDeg": {
          "type": "integer",
          "enum": [
            0,
            30,
            60,
            90
          ]
        },
        "aspect": {
          "type": "string",
          "enum": [
            "N",
            "O",
            "S",
            "W"
          ]
        },
        "albedo": {
          "type": "number",
          "const": 0.2
        }
      },
      "required": [
        "tiltDeg",
        "aspect",
        "albedo"
      ],
      "additionalProperties": false
    },
    "queries": {
      "type": "object",
      "properties": {
        "canonicalQuery": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "pvgis"
            },
            "apiVersion": {
              "type": "string",
              "const": "5_3"
            },
            "radiationDatabase": {
              "type": "string",
              "const": "PVGIS-SARAH3"
            }
          },
          "required": [
            "provider",
            "apiVersion",
            "radiationDatabase"
          ],
          "additionalProperties": false
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "canonicalQuery",
        "fetchedAt"
      ],
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rawSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "name",
        "rawSha256"
      ],
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "atol": {
          "type": "number",
          "minimum": 0
        },
        "rtol": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "atol",
        "rtol"
      ],
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "properties": {
        "point_hourly": {
          "$ref": "#/$defs/gate"
        },
        "monthly": {
          "$ref": "#/$defs/gate"
        },
        "annual": {
          "$ref": "#/$defs/gate"
        },
        "night": {
          "$ref": "#/$defs/gate"
        },
        "energy": {
          "$ref": "#/$defs/gate"
        }
      },
      "required": [
        "point_hourly",
        "monthly",
        "annual",
        "night",
        "energy"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "inputsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fixtureSha256s": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "statistics": {
          "type": "object",
          "properties": {
            "p99": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "p99",
            "max"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        }
      },
      "required": [
        "inputsSha256",
        "fixtureSha256s",
        "statistics",
        "provenance",
        "result"
      ],
      "additionalProperties": false
    }
  }
}
