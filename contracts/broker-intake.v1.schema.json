{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wmee:contract:broker-intake.v1",
  "title": "WMEE Broker Intake v1",
  "description": "Kanonischer Übergabevertrag für Broker-Leads (Katalog F1.2: Wattfox, Aroundhome, DAA, Eza, Interlead, Bitrix) an Energie-SaaS. Dedupe über Broker-Record-ID, cross-broker nur kontaktbasiert. Synthetischer Broker: inbound only, keine Provider-Calls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "brokerKey",
    "brokerRecordId",
    "submittedAt",
    "customer",
    "site",
    "note"
  ],
  "properties": {
    "contractVersion": {
      "const": "broker-intake.v1"
    },
    "brokerKey": {
      "enum": [
        "wattfox",
        "aroundhome",
        "daa",
        "eza",
        "interlead",
        "bitrix"
      ]
    },
    "brokerRecordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "submittedAt": {
      "$ref": "#/$defs/contractDateTime"
    },
    "customer": {
      "$ref": "#/$defs/customer"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "note": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "nullableShortText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "contractDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,3})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "email",
        "phoneRaw"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "phoneRaw": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addressMode",
        "formattedAddress",
        "street",
        "houseNumber",
        "postalCode",
        "city",
        "countryCode",
        "latitude",
        "longitude",
        "geocodeSource",
        "precision"
      ],
      "properties": {
        "addressMode": {
          "enum": [
            "selected",
            "regional_estimate"
          ]
        },
        "formattedAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "street": {
          "$ref": "#/$defs/nullableShortText"
        },
        "houseNumber": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "postalCode": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "city": {
          "$ref": "#/$defs/nullableShortText"
        },
        "countryCode": {
          "const": "DE"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "geocodeSource": {
          "enum": [
            "broker",
            "regional_default"
          ]
        },
        "precision": {
          "enum": [
            "house",
            "street",
            "locality",
            "region"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "addressMode": {
                "const": "selected"
              }
            },
            "required": [
              "addressMode"
            ]
          },
          "then": {
            "properties": {
              "street": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "houseNumber": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "postalCode": {
                "type": "string",
                "pattern": "^[0-9]{5}$"
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "geocodeSource": {
                "const": "broker"
              },
              "precision": {
                "const": "house"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "addressMode": {
                "const": "regional_estimate"
              }
            },
            "required": [
              "addressMode"
            ]
          },
          "then": {
            "properties": {
              "street": {
                "type": "null"
              },
              "houseNumber": {
                "type": "null"
              },
              "postalCode": {
                "type": "null"
              },
              "city": {
                "type": "null"
              },
              "geocodeSource": {
                "const": "regional_default"
              },
              "precision": {
                "const": "region"
              }
            }
          }
        }
      ]
    }
  }
}
